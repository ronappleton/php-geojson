<?xml version="1.0"?>
<ruleset name="PHP Mess Detector rules"
    xmlns="http://pmd.sf.net/ruleset/1.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://pmd.sf.net/ruleset/1.0.0 http://pmd.sf.net/ruleset_xml_schema.xsd"
    xsi:noNamespaceSchemaLocation="http://pmd.sf.net/ruleset_xml_schema.xsd">
    <description>PHPMD ruleset aligned with the Codacy analysis for this library.</description>

    <!-- Parser is a deliberately monolithic parser; complexity and coupling
         metrics add no signal for it, mirroring the existing PHP_CodeSniffer
         exclusion of Parser from the cyclomatic complexity check. -->
    <exclude-pattern>src/Objects/Parser.php</exclude-pattern>

    <!-- Static access to the Factory and enum lookup is the intended design of
         this library, so the StaticAccess and Superglobals rules are disabled. -->
    <rule ref="rulesets/cleancode.xml">
        <exclude name="StaticAccess"/>
        <exclude name="Superglobals"/>
    </rule>

    <rule ref="rulesets/codesize.xml"/>
    <rule ref="rulesets/design.xml"/>

    <rule ref="rulesets/naming.xml">
        <exclude name="ShortVariable"/>
    </rule>

    <!-- $id is the standard GeoJSON "id" member name (RFC 7946). -->
    <rule ref="rulesets/naming.xml/ShortVariable">
        <properties>
            <property name="exceptions" value="id"/>
        </properties>
    </rule>

    <rule ref="rulesets/unusedcode.xml"/>
</ruleset>