{
    "name": "ronappleton/php-geojson",
    "description": "GeoJSON object builder.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "RonAppleton\\GeoJson\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RonAppleton\\GeoJson\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Ron Appleton",
            "email": "ron.appleton@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "slevomat/coding-standard": "^8.15",
        "squizlabs/php_codesniffer": "^3.8",
        "webimpress/coding-standard": "^1.3"
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs": "phpcs --standard=ruleset.xml src tests",
        "cs:fix": "phpcbf --standard=ruleset.xml src tests"
    }
}
